<UserControl x:Class="WpfDimEditor.Controls.NumericCompareEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfDimEditor.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Muted Original Value Label -->
        <TextBlock Grid.Column="0" 
                   Text="{Binding OriginalValue, StringFormat='{}{0:F1}'}"
                   VerticalAlignment="Center"
                   Margin="5,0"
                   Foreground="#888888"
                   FontSize="12"/>
        
        <!-- Editable TextBox -->
        <TextBox x:Name="ValueTextBox"
                 Grid.Column="1"
                 Text="{Binding CurrentValue, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F1}'}"
                 VerticalAlignment="Center"
                 Padding="4,2"
                 PreviewKeyDown="ValueTextBox_PreviewKeyDown"
                 GotFocus="ValueTextBox_GotFocus"
                 LostFocus="ValueTextBox_LostFocus"/>
        
        <!-- Popup for details -->
        <Popup x:Name="DetailsPopup"
               PlacementTarget="{Binding ElementName=ValueTextBox}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="White" 
                    BorderBrush="#CCCCCC" 
                    BorderThickness="1"
                    Padding="10"
                    CornerRadius="3">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="5" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock FontWeight="Bold" Margin="0,0,0,5">Details</TextBlock>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Original:"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" 
                                   Text="{Binding OriginalValue, StringFormat='{}{0:F1}'}"
                                   FontWeight="Bold"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Current:"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" 
                                   Text="{Binding CurrentValue, StringFormat='{}{0:F1}'}"
                                   FontWeight="Bold"/>
                        
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Δ (Delta):"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" 
                                   Text="{Binding Delta, StringFormat='{}{0:F1}'}"
                                   FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Delta}" Value="0">
                                            <Setter Property="Foreground" Value="Gray"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        
                        <Button Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                                Content="Revert to Original"
                                Command="{Binding RevertCommand}"
                                Padding="10,3"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
